/** Logótipos usados no PDF, no email e na ficha (PNG em base64). */
const LOGO_CABLOTEC_B64 = '';
const LOGO_ARALAB_B64 = '';

function logoBlob_(qual) {
  const b64 = qual === 'aralab' ? LOGO_ARALAB_B64 : LOGO_CABLOTEC_B64;
  return Utilities.newBlob(Utilities.base64Decode(b64), 'image/png', 'logo-' + qual + '.png');
}
function logoDataUri_(qual) {
  return 'data:image/png;base64,' + (qual === 'aralab' ? LOGO_ARALAB_B64 : LOGO_CABLOTEC_B64);
}
